# Copy this file to .env and fill in real values for production.
# Local development works with none of these set (defaults to SQLite + insecure dev key).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Shown in the sidebar, browser tab title, and admin login page.
COMPANY_NAME=SSM Centring Rentals

# Google sign-in ("Sign in with Google" button on the login page). Get these from
# https://console.cloud.google.com/ -> APIs & Services -> Credentials -> Create OAuth
# client ID (type: Web application). Add this authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/login/callback/   (local dev)
#   https://your-domain.com/accounts/google/login/callback/ (production, once deployed)
# The "Sign in with Google" button is hidden until both values below are set.
# New accounts created via Google sign-in have NO admin access by default - grant
# staff/superuser status manually under Users in the admin site.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set DB_ENGINE=postgres to switch from local SQLite to Postgres (production).
# DB_ENGINE=postgres
# DB_NAME=ssm_crm
# DB_USER=ssm_crm
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
